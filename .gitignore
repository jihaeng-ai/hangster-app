# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 삭제 대기 파일 (사용자가 직접 확인 후 삭제)
/trash-can/

# 로컬 저장소: 올린 원본과 읽은 결과 (샘플 data/samples/는 커밋함)
/data/uploads/
/data/store.json
/data/store.json.*.tmp

# 이 PC의 작업 도구 기록 (bkit 작업 기록, Claude 설정·보안 검토 메모) — 공개 저장소에 올리지 않는다
/.bkit/
/.claude/
